# development | production. In production INTERNAL_API_KEY is required and /docs is disabled.
ENVIRONMENT=development

# Maximum resume text length in characters (default 100000)
MAX_RESUME_TEXT_LENGTH=100000

# Maximum job description text length in characters (default 50000).
# Must be at least the backend's 50000-character limit.
MAX_JOB_DESCRIPTION_TEXT_LENGTH=50000

# Shared secret expected in the X-Internal-API-Key header from the Node backend.
# May be empty in local development only; required (32+ characters) in production. Must match backend INTERNAL_API_KEY.
INTERNAL_API_KEY=

# Comma-separated browser origins allowed via CORS. Empty by default: only the backend calls this service.
CORS_ORIGINS=

# Semantic matching (Step 6C). Hugging Face model id for the embedding model.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Load the model in the background at startup (true) or on the first semantic request (false).
PRELOAD_EMBEDDING_MODEL=true
