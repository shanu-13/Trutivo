# Backend settings. Copy to backend/.env for local development; in production set
# these in the hosting platform's secret/environment settings. Placeholders only.

# development | production. Production refuses to start with missing or weak secrets.
NODE_ENV=development
PORT=5000

# Session tokens. At least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRES_IN=7d

# Browser origin(s) of the frontend, comma-separated (CORS). https in production.
FRONTEND_URL=http://localhost:3000
# Session cookie. lax works when frontend and API share a site (app.example.com + api.example.com).
# For different sites use COOKIE_SAMESITE=none with COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Defaults to true in production and false in development.
COOKIE_SECURE=
# Number of reverse proxies / load balancers in front of the backend (for client IPs in rate limits).
TRUST_PROXY=

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000
# Semantic matching can wait for the embedding model to load after an AI-service restart.
AI_SEMANTIC_TIMEOUT_MS=30000
# Shared secret sent to the AI service as X-Internal-API-Key. Must match ai-service INTERNAL_API_KEY.
# Optional in development; required (32+ characters) in production.
INTERNAL_API_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_resume_analyzer
DB_USER=root
DB_PASSWORD=

# Private resume storage (absolute path). Defaults to backend/uploads/resumes.
# Must be persistent storage in production and must not move once files exist.
UPLOAD_DIR=
# Where `npm run migrate` finds the SQL files. Defaults to ../database/migrations.
MIGRATIONS_DIR=

# Rate limits (per backend process).
LOGIN_ATTEMPTS_PER_15_MIN=20
REGISTRATIONS_PER_HOUR=10
COVER_LETTER_GENERATE_PER_MINUTE=10
INTERVIEW_CREATE_PER_MINUTE=5
INTERVIEW_EVALUATE_PER_MINUTE=30
INTERVIEW_DRAFTS_PER_MINUTE=120

# Mock interviews: questions per session (1-15) and maximum answer length.
INTERVIEW_MAX_QUESTIONS=10
INTERVIEW_ANSWER_MAX_CHARS=5000

# Development only: enables GET /api/test/db-ops (never available in production).
ENABLE_TEST_ROUTES=false
