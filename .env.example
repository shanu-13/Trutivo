# Settings for docker-compose.yml (copy to .env and replace every placeholder).
# For running services directly, use backend/.env.example, ai-service/.env.example
# and frontend/.env.example instead. Never commit the real .env.

# Database (MySQL container)
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=ai_resume_analyzer
DB_USER=resume_app
DB_PASSWORD=replace-with-a-strong-app-password

# Backend
# At least 32 random characters, e.g. from: openssl rand -hex 32
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRES_IN=7d
# Browser origin(s) of the frontend, comma-separated.
FRONTEND_URL=http://localhost:3000
COOKIE_SAMESITE=lax

# Shared secret between the backend and the AI service (at least 32 characters).
INTERNAL_API_KEY=replace-with-another-64-random-hex-characters

# Frontend: the backend address as the browser sees it (compiled in at build time).
PUBLIC_API_URL=http://localhost:5000/api

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
